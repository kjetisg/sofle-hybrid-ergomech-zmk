// Sofle Ergomech - Beginner-Friendly & Programmer-Optimized Keymap
// Layers: Base QWERTY + Home-row Mods | Symbols/Numbers | Navigation/IDE | Gaming | Norwegian (momentary) | Adjust
// Target: Coding (C/C++, Python, Rust) + Gaming (GuildWars2) + English/Norwegian typing

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

// ==================== LAYER DEFINITIONS ====================
#define BASE 0
#define SYMBOLS 1
#define NAV 2
#define GAMING 3
#define NORWEGIAN 4
#define ADJUST 5

// ==================== BEHAVIOR DEFINITIONS ====================
/ {
    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
			tap-ms = <20>;
        };

        // Safe Home-row mods: require-prior-idle prevents misfires during fast typing
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <240>;       
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>; 
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47>;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <240>;       
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>; 
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
        };

        // Encoder: rotate through the layer ring using the roller
        my_encoder_cycle_base: my_encoder_cycle_base {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to SYMBOLS>, <&to ADJUST>;
        };

        my_encoder_cycle_symbols: my_encoder_cycle_symbols {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to NAV>, <&to BASE>;
        };

        my_encoder_cycle_nav: my_encoder_cycle_nav {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to GAMING>, <&to SYMBOLS>;
        };

        my_encoder_cycle_gaming: my_encoder_cycle_gaming {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to NORWEGIAN>, <&to NAV>;
        };

        my_encoder_cycle_norwegian: my_encoder_cycle_norwegian {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to ADJUST>, <&to GAMING>;
        };

        my_encoder_cycle_adjust: my_encoder_cycle_adjust {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to BASE>, <&to NORWEGIAN>;
        };
    };

    // ==================== MACROS ====================
    macros {
        save_file: save_file { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(S)>; };
        open_file: open_file { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(K) &kp LC(O)>; };
        find_in_files: find_in_files { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LS(F))>; };
        go_to_definition: go_to_definition { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LS(I))>; };
        quick_format: quick_format { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(F))>; };
        
        auto_paren: auto_paren { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LPAR &kp RPAR &kp LEFT>; };
        auto_bracket: auto_bracket { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LBRC &kp RBRC &kp LEFT>; };
        auto_brace: auto_brace { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LBKT &kp RBKT &kp LEFT>; };
        
        eqeq: eqeq { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp EQUAL &kp EQUAL>; };
        scope_op: scope_op { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(SEMICOLON) &kp LS(SEMICOLON)>; };
        arrow_op: arrow_op { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp MINUS &kp GT>; };
        toggle_weapon: toggle_weapon { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp TAB>; };
    };

    // ==================== COMBOS ====================
    combos {
        compatible = "zmk,combos";
        combo_caps { timeout-ms = <50>; key-positions = <20 21>; bindings = <&kp CAPS>; };
    };

    // ==================== KEYMAP ====================
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&kp ESCAPE   &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                            &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS
&kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                             &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSLH
&kp LSHFT    &hm_l LGUI A &hm_l LALT S &hm_l LCTRL D &hm_l LSHIFT F &kp G                           &kp H        &hm_r RSHIFT J &hm_r RCTRL K &hm_r RALT L &hm_r RGUI SEMI &kp SQT
&kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp C_MUTE &kp C_PLAY_PAUSE &kp N &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
                          &kp LGUI     &kp LALT     &kp RETURN   &kp SPACE    &mo SYMBOLS                       &mo NAV      &kp BSPC     &mo NORWEGIAN &kp RCTRL
&kp C_PLAY_PAUSE &kp UP_ARROW &kp DOWN_ARROW &kp LEFT_ARROW &kp RIGHT_ARROW
            >;
            sensor-bindings = <&my_encoder_cycle_base>;
        };

        layer_1 {
            display-name = "SYMBOLS";
            bindings = <
&trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                            &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp F11
&trans       &kp EXCL     &kp LT       &kp GT       &kp EQUAL    &kp DLLR                          &kp AMPS     &auto_brace  &kp RBKT     &kp BSLH     &kp PRCNT    &kp F12
&trans       &kp GRAVE    &kp MINUS    &kp PLUS     &kp ASTRK    &kp COLON                         &scope_op    &auto_paren  &kp RPAR     &kp PIPE     &kp QMARK    &kp PIPE
&trans       &kp TILDE    &kp UNDER    &kp FSLH     &kp POUND    &eqeq        &trans     &trans    &arrow_op    &auto_bracket &kp RBRC    &kp AT       &kp CARET    &trans
                          &trans       &trans       &trans       &trans       &trans                            &trans       &trans       &trans       &trans
&kp C_PLAY_PAUSE &kp UP_ARROW &kp DOWN_ARROW &kp LEFT_ARROW &kp RIGHT_ARROW
            >;
            sensor-bindings = <&my_encoder_cycle_symbols>;
        };

        layer_2 {
            display-name = "NAV";
            bindings = <
&kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                            &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
&trans       &save_file   &open_file   &find_in_files &go_to_definition &quick_format                  &kp HOME     &kp PGDN     &kp PGUP     &kp END      &kp DEL      &trans
&trans       &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHIFT   &trans                            &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp BSPC     &trans
&trans       &trans       &trans       &trans       &trans       &trans       &trans     &trans    &trans       &trans       &trans       &trans       &trans       &trans
                          &trans       &trans       &trans       &trans       &trans                            &trans       &trans       &trans       &trans
&kp C_PLAY_PAUSE &kp UP_ARROW &kp DOWN_ARROW &kp LEFT_ARROW &kp RIGHT_ARROW
            >;
            sensor-bindings = <&my_encoder_cycle_nav>;
        };

        layer_3 {
            display-name = "GAMING";
            bindings = <
&kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                            &trans       &trans       &trans       &trans       &trans       &trans
&kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T                             &trans       &trans       &trans       &trans       &trans       &trans
&kp LSHFT    &kp A        &kp S        &kp D        &kp F        &kp G                             &trans       &trans       &trans       &trans       &trans       &trans
&kp LCTRL    &kp Z        &kp X        &kp C        &kp V        &kp B        &toggle_weapon &trans  &trans       &trans       &trans       &trans       &trans       &trans
                          &trans       &trans       &trans       &kp SPACE    &trans                            &trans       &trans       &trans       &trans
&kp C_PLAY_PAUSE &kp UP_ARROW &kp DOWN_ARROW &kp LEFT_ARROW &kp RIGHT_ARROW
            >;
            sensor-bindings = <&my_encoder_cycle_gaming>;
        };

        layer_4 {
            display-name = "NORD";
            bindings = <
&trans       &trans       &trans       &trans       &trans       &trans                            &trans       &trans       &trans       &trans       &trans       &trans
&trans       &trans       &trans       &kp SQT      &trans       &trans                            &trans       &trans       &trans       &kp SEMI     &trans       &trans
&trans       &kp LBKT     &trans       &trans       &trans       &trans                            &trans       &trans       &trans       &trans       &trans       &trans
&trans       &trans       &trans       &trans       &trans       &trans       &trans     &trans    &trans       &trans       &trans       &trans       &trans       &trans
                          &trans       &trans       &trans       &trans       &trans                            &trans       &trans       &trans       &trans
&kp C_PLAY_PAUSE &kp UP_ARROW &kp DOWN_ARROW &kp LEFT_ARROW &kp RIGHT_ARROW
            >;
            sensor-bindings = <&my_encoder_cycle_norwegian>;
        };

        layer_5 {
            display-name = "ADJUST";
            bindings = <
&bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                      &trans       &trans       &trans       &trans       &trans       &trans
&studio_unlock &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF     &trans       &trans       &trans       &trans       &trans       &trans
&trans       &trans       &rgb_ug RGB_BRI &trans       &trans       &trans                            &trans       &trans       &trans       &trans       &trans       &trans
&ext_power EP_TOG &trans   &trans       &trans       &trans       &trans       &rgb_ug RGB_TOG &trans &trans &trans       &trans       &trans       &trans       &trans
                          &trans       &trans       &trans       &trans       &trans                            &trans       &trans       &trans       &trans
&kp C_PLAY_PAUSE &kp UP_ARROW &kp DOWN_ARROW &kp LEFT_ARROW &kp RIGHT_ARROW
            >;
            sensor-bindings = <&my_encoder_cycle_adjust>;
        };
    };
};