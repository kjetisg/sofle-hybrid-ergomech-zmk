  "notes": {
    "layer_0": "Base QWERTY with home-row mods. A=Shift, S=Ctrl, D=Alt, F=GUI on left; J=GUI, K=Alt, L=Ctrl, ';=Shift on right.",
    "layer_1": "Numbers (numpad layout) and programming symbols. Includes auto-bracket macros.",
    "layer_2": "IDE shortcuts (Ctrl+K Ctrl+O for open, Ctrl+S for save) and one-handed navigation (HJKL-style).",
    "layer_3": "Gaming optimized: WASD accessible, quick ability hotbar (1-6), push-to-talk support.",
    "layer_4": "Norwegian characters - access ø/Ø, æ/Æ, å/Å. Use Alt-codes or OS composition.",
    "layer_5": "Bluetooth profile switching, RGB underglow control, power management, reset/bootloader.",
    "combos": [
      "12 = ~ (tilde)",
      "23 = @ (at)",
      "34 = # (hash)",
      "45 = $ (dollar)",
      "2021 = Caps Lock"
    ],
    "macros": [
      "Layer 2: Open file (Ctrl+K Ctrl+O), Save (Ctrl+S), Find in files (Ctrl+Shift+F)",
      "Layer 2: Go to definition (Ctrl+Shift+I), Format document (Ctrl+Alt+F)",
      "Layer 1: Auto-parentheses, brackets, braces"
    ],
    "encoder": {
      "rotate_normal": "Volume up/down",
      "rotate_with_alt": "Layer switching (cycle through layers)",
      "rotate_with_ctrl": "Tab switching (Ctrl+Tab / Ctrl+Shift+Tab)",
      "press": "Mute or custom macro"
    },
    "five_way_switch": {
      "press": "Toggle Gaming layer",
      "up": "Navigation/IDE layer",
      "down": "Norwegian layer",
      "left": "Reserved for future use",
      "right": "Reserved for future use"
    }
  },
